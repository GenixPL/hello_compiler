[
  {
    "label": "run main",
    "command": "zsh $ZED_WORKTREE_ROOT/scripts/compile_n_run_assembly.sh",
    // Reuses the same terminal per task.
    "use_new_terminal": false,
    // Terminates current task if new one is spawned.
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "save": "current",
  },
  {
    "label": "run dart",
    "command": "dart run $ZED_FILE",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "save": "current",
  },
]
